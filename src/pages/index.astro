---
import { services, siteConfig } from "../content";
import "../styles.css";

const icon = (name: "arrow" | "sparkles" | "menu" | "close" | "video" | "card" | "check" | "person") => {
  const paths = {
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
    sparkles: '<path d="m12 3-1.9 4.8a2 2 0 0 1-1.2 1.2L4 11l4.9 1.9a2 2 0 0 1 1.2 1.2L12 19l1.9-4.9a2 2 0 0 1 1.2-1.2L20 11l-4.9-1.9a2 2 0 0 1-1.2-1.2Z"/>',
    menu: '<path d="M4 6h16M4 12h16M4 18h16"/>',
    close: '<path d="M18 6 6 18M6 6l12 12"/>',
    video: '<path d="M8 8h8a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2H9l-4 3v-3a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h3Z"/><path d="m11 11 3 2-3 2Z"/>',
    card: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/>',
    check: '<path d="m5 12 4 4L19 6"/><path d="m9 10 3 3 7-7"/>',
    person: '<circle cx="12" cy="8" r="3"/><path d="M6 20c0-3.3 2.7-6 6-6 1.1 0 2.2.3 3.1.8"/><path d="m16 18 2 2 4-5"/>',
  };
  return `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${paths[name]}</svg>`;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Compassionate, person-centered counseling for individuals, couples, and families." />
    <title>{siteConfig.name}</title>
  </head>
  <body>
    <div class="site-shell">
      <header class="header">
        <a href="#top" class="brand" aria-label={`${siteConfig.name} home`}>
          <img class="brand-logo" src="/assets/logo.png" alt={`${siteConfig.name} logo`} />
          <span class="brand-copy">A New Beginning Counseling Center</span>
        </a>
        <button class="menu-button" aria-label="Toggle navigation" aria-expanded="false">
          <span class="menu-icon" set:html={icon("menu")} />
          <span class="close-icon" hidden set:html={icon("close")} />
        </button>
        <nav class="nav" aria-label="Main navigation">
          <a href="#about">About</a><a href="#services">Services</a><a href="/team" target="_blank" rel="noopener" aria-label="Our team (opens in a new tab)">Our team</a><a href="/contact">Contact</a>
          <a class="portal-link" href={siteConfig.portalUrl}>Client portal <span set:html={icon("arrow")} /></a>
        </nav>
      </header>

      <main id="top">
        <section class="hero">
          <div class="hero-copy">
            <p class="eyebrow">Compassionate care, centered on you</p>
            <h1>A steady place to <em>begin again.</em></h1>
            <p class="hero-intro">It is always possible to start over. No matter what you are carrying, our team is here to help you find lasting and meaningful change.</p>
            <div class="hero-actions">
              <a class="button primary" href="/contact">Start a conversation <span set:html={icon("arrow")} /></a>
              <a class="text-link" href="/team" target="_blank" rel="noopener">Meet our counselors</a>
            </div>
          </div>
          <div class="hero-art" aria-label="A calm abstract composition">
            <div class="sun-shape"></div><div class="arch-shape"></div><div class="leaf leaf-one"></div><div class="leaf leaf-two"></div>
            <div class="hero-note"><i set:html={icon("sparkles")} /><span>Care that meets you where you are.</span></div>
          </div>
        </section>

        <section class="practice-features" aria-label="Practice availability and payment options">
          <div class="practice-feature">
            <span class="feature-icon" set:html={icon("video")} />
            <h2>Offers Telehealth<br />Appointments</h2>
          </div>
          <div class="practice-feature">
            <span class="feature-icon" set:html={icon("card")} />
            <h2>Accepts<br />Online Payments</h2>
          </div>
          <div class="practice-feature">
            <span class="feature-icon" set:html={icon("check")} />
            <h2>Accepts<br />Insurance</h2>
          </div>
          <div class="practice-feature">
            <span class="feature-icon" set:html={icon("person")} />
            <h2>Accepting New<br />Clients</h2>
          </div>
        </section>

        <section class="intro section" id="about">
          <div><p class="eyebrow">Welcome to A New Beginning</p><h2>Healing looks different for everyone.</h2></div>
          <div class="intro-body">
            <p>A New Beginning Counseling Center is a team of professionals here to help you find a new path forward. Whether you are dealing with past traumas, current stress, or both, we are here. We believe change starts with trust and felt safety. We strive to honor your unique experience and work toward your unique goals.</p>
          </div>
        </section>

        <section class="services section" id="services">
          <div class="section-heading"><h2>How we can help</h2><p>Explore a range of counseling services for different ages, relationships, and seasons of life.</p></div>
          <div class="service-grid">
            {services.map((service) => <article class="service-card"><span class="service-number">{service.number}</span><h3>{service.title}</h3><p>{service.description}</p></article>)}
          </div>
        </section>

        <section class="approach section">
          <div class="approach-visual"><div class="approach-ring"></div><blockquote>You deserve support that feels human, hopeful, and truly yours.</blockquote></div>
          <div class="approach-copy"><p class="eyebrow">Our approach</p><h2>Professional care with a deeply personal touch.</h2><p>Our work is grounded in warmth, respect, and proven therapeutic practices. We make space for the whole person, not just a diagnosis or a difficult season.</p><ul><li><span>01</span> A relationship built on safety and trust</li><li><span>02</span> Care shaped around your unique goals</li><li><span>03</span> Practical tools for change beyond the session</li></ul></div>
        </section>

        <section class="team-invitation section" id="team">
          <div><p class="eyebrow">Our counselors</p><h2>Meet the team</h2></div>
          <div><p>Each counselor brings their own training, perspective, and way of connecting. Finding the right fit matters.</p><a class="button primary" href="/team" target="_blank" rel="noopener">View our team <span set:html={icon("arrow")} /></a></div>
        </section>

        <section class="portal-banner" id="client-portal"><div><p class="eyebrow light">Already a client?</p><h2>Your care, one click away.</h2><p>Access appointments, secure messages, forms, and account information through the client portal.</p></div><a class="button light-button" href={siteConfig.portalUrl}>Open client portal <span set:html={icon("arrow")} /></a></section>

        <section class="contact section" id="contact"><div><p class="eyebrow">Take the first step</p><h2>Let’s find the right support for you.</h2><p>Reaching out can feel like the hardest part. Send us a note or give us a call and we will help you understand what comes next.</p></div><div class="contact-card"><a href={`tel:${siteConfig.phone.replace(/\D/g, "")}`}><span>Call</span>{siteConfig.phone}</a><div><span>Fax</span>{siteConfig.fax}</div><a href={`mailto:${siteConfig.email}`}><span>Email</span>{siteConfig.email}</a><div><span>Location</span>{siteConfig.location}</div><p class="contact-note">If you are experiencing an emergency, call 911 or visit your nearest emergency room.</p></div></section>
      </main>

      <footer><a href="#top" class="brand footer-brand"><img class="brand-logo" src="/assets/logo.png" alt={`${siteConfig.name} logo`} /><span class="brand-copy">A New Beginning Counseling Center</span></a><p>Compassionate counseling for individuals, couples, and families.</p><div class="footer-links"><a href="#services">Services</a><a href="/team" target="_blank" rel="noopener">Our team</a><a href="/contact">Contact</a><a href={siteConfig.portalUrl}>Client portal</a></div><small>© {new Date().getFullYear()} {siteConfig.name}. All rights reserved.</small></footer>
    </div>
    <script>
      const button = document.querySelector<HTMLButtonElement>(".menu-button");
      const nav = document.querySelector<HTMLElement>(".nav");
      const menuIcon = document.querySelector<HTMLElement>(".menu-icon");
      const closeIcon = document.querySelector<HTMLElement>(".close-icon");
      button?.addEventListener("click", () => {
        const open = nav?.classList.toggle("open") ?? false;
        button.setAttribute("aria-expanded", String(open));
        if (menuIcon) menuIcon.hidden = open;
        if (closeIcon) closeIcon.hidden = !open;
      });
      nav?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        nav.classList.remove("open"); button?.setAttribute("aria-expanded", "false");
        if (menuIcon) menuIcon.hidden = false; if (closeIcon) closeIcon.hidden = true;
      }));
    </script>
  </body>
</html>
